{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "01 Check tools",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/check-xsim.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "02 Simulate",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/simulate-xsim.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "03 Open waveform",
      "type": "process",
      "command": "${execPath}",
      "args": ["--reuse-window", "${workspaceFolder}\\build\\sim\\wave.vcd"],
      "dependsOrder": "sequence",
      "dependsOn": ["02 Simulate"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
